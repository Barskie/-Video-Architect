# Required. Keep this server-side; never prefix it with VITE_.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional cost/quality override. The default is the stable, efficient model below.
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional comma-separated extra origins. The deployed request host is allowed automatically.
ALLOWED_ORIGINS="http://localhost:3000"

# Defense-in-depth limits per warm serverless instance. Add a Vercel WAF rule for a global limit.
ANALYZE_RATE_LIMIT_MAX="5"
ANALYZE_MAX_CONCURRENT="3"
